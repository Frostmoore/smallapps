<?xml version="1.0" encoding="utf-8"?>
<!--
  Stili e testi di riserva del widget (F5). I testi stanno qui perche' il selettore dei widget e
  il primo disegno avvengono prima che l'app sia mai partita. Italiano in values-it/widget.xml.
-->
<resources>
    <string name="widget_label">Scorte Calore</string>
    <string name="widget_description">Days left and the reorder date of your heat sources.</string>
    <string name="widget_title">HEATING STOCK</string>
    <string name="widget_open_app">Open Scorte Calore to add a heat source.</string>
    <string name="widget_sample1">Living room stove</string>
    <string name="widget_sample2">LPG tank</string>

    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="WidgetTexts">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="WidgetName">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetDetail">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFC9D3E6</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetDays">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:textColor">#FFFF7A3D</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
