    {
      "name": "negozi",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"negozi\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"nome\" TEXT NOT NULL UNIQUE COLLATE NOCASE CHECK (length(nome) BETWEEN 1 AND 60), \"creato_il\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "spese",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"spese\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"stato\" TEXT NOT NULL CHECK(\"stato\" IN ('in_corso', 'chiusa')), \"negozio_id\" INTEGER NULL REFERENCES negozi (id) ON DELETE SET NULL, \"iniziata_il\" INTEGER NOT NULL, \"chiusa_il\" INTEGER NULL, \"data_spesa\" TEXT NULL, \"budget_cents\" INTEGER NULL CHECK(\"budget_cents\" > 0), \"totale_cents\" INTEGER NOT NULL DEFAULT 0, \"totale_scontrino_cents\" INTEGER NULL, \"fonte\" TEXT NOT NULL DEFAULT 'contate' CHECK(\"fonte\" IN ('contate', 'scontrino')), CHECK ((stato = 'chiusa') = (chiusa_il IS NOT NULL)), CHECK (stato <> 'chiusa' OR data_spesa IS NOT NULL));"
        }
      ]
    },
    {
      "name": "righe",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"righe\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"spesa_id\" INTEGER NOT NULL REFERENCES spese (id) ON DELETE CASCADE, \"insieme\" TEXT NOT NULL CHECK(\"insieme\" IN ('contate', 'scontrino')), \"posizione\" INTEGER NOT NULL, \"nome\" TEXT NOT NULL DEFAULT '' CHECK(LENGTH(\"nome\") <= 80), \"pezzi\" INTEGER NULL CHECK(\"pezzi\" BETWEEN 1 AND 999), \"millesimi\" INTEGER NULL CHECK(\"millesimi\" BETWEEN 1 AND 99999), \"unita\" TEXT NULL CHECK(\"unita\" IN ('kg', 'l')), \"prezzo_unitario_cents\" INTEGER NOT NULL CHECK(NOT (\"prezzo_unitario_cents\" = 0)), \"totale_cents\" INTEGER NOT NULL, \"offerta_json\" TEXT NULL, \"prezzo_rif_cents\" INTEGER NULL, \"unita_rif\" TEXT NULL CHECK(\"unita_rif\" IN ('kg', 'l')), \"totale_stampato_cents\" INTEGER NULL, \"origine\" TEXT NOT NULL CHECK(\"origine\" IN ('tastierino', 'cartellino', 'bilancia', 'scontrino')), \"stornata\" INTEGER NOT NULL DEFAULT 0 CHECK (\"stornata\" IN (0, 1)), \"creata_il\" INTEGER NOT NULL, CHECK ((pezzi IS NOT NULL AND millesimi IS NULL AND unita IS NULL) OR (pezzi IS NULL AND millesimi IS NOT NULL AND unita IS NOT NULL)));"
        }
      ]
    },
