<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gli acquisti in-app. La libreria di Google la dichiara gia' per conto suo, ma e' il
         manifest dell'app a dire cosa l'app fa: se un giorno la dipendenza cambiasse, il
         permesso sparirebbe in silenzio e Play Console rifiuterebbe di creare il prodotto Pro
         (guarda il bundle caricato, non il codice). Vedi apps/trashcan.

         I permessi si aggiungono con le sottofasi che li usano, non prima: un permesso
         dichiarato e non usato e' una domanda in piu' nella revisione di Play. -->
    <uses-permission android:name="com.android.vending.BILLING"/>

    <!-- Notifiche (F4.9). Gli allarmi di Android non sopravvivono al riavvio: senza
         RECEIVE_BOOT_COMPLETED e il receiver qui sotto, dopo un riavvio i riepiloghi
         smettono di arrivare e niente lo dice. Niente SCHEDULE_EXACT_ALARM: i riepiloghi
         sono inesatti per scelta (ADR-009), arrivare alle 18:07 invece che alle 18 va bene. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Voce (F4.12): il microfono per dettare il nome. Il riconoscimento lo fa il servizio
         di sistema; senza la <queries> qui sotto, da Android 11 l'app non lo "vede" e
         speech_to_text risponde che non c'e' nessun riconoscitore. Niente INTERNET e
         niente Bluetooth: li chiede il README del plugin, ma la rete la usa il servizio di
         Google (un'altra app), e le cuffie non servono a dettare "due porzioni". -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <application
        android:label="Full Freezer"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- ☠ Il deep link di Flutter va spento: il tocco sul widget arriva con l'URI
                 fullfreezer:///use-soon, e con questa voce accesa Flutter lo passava da solo a
                 go_router come `go`, che sostituisce la pila. Risultato visto sull'emulatore
                 il 2026-10-07: "Da usare prima" senza freccia indietro, e da app chiusa la
                 home invece della pagina. Gli URI li gestisce solo app.dart (_openWidgetUri). -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Il widget (F4.11). Vedi FullFreezerWidgetProvider.kt. exported="true" e'
             obbligatorio: APPWIDGET_UPDATE lo manda il sistema, che e' un'altra app. -->
        <receiver
            android:name=".FullFreezerWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/full_freezer_widget_info" />
        </receiver>

        <!-- ☠ Senza questo receiver l'allarme delle 00:05 scatta e non arriva a nessuno: il
             widget resterebbe ai giorni di ieri fino al prossimo avvio (lezione di TrashCan).
             BOOT_COMPLETED e MY_PACKAGE_REPLACED riarmano l'allarme dopo un riavvio o un
             aggiornamento. -->
        <receiver
            android:name="es.antonborri.home_widget.HomeWidgetScheduledUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.SCHEDULED_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Senza questi due receiver il plugin non ha nessuno a cui consegnare la notifica
             quando l'allarme scatta: si pianifica senza errori e la notifica non arriva mai.
             Stessa trappola gia' disinnescata in TrashCan. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
