<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Gli acquisti in-app: dichiarato qui e non solo dalla libreria, perche' Play Console guarda
         il pacchetto caricato per sbloccare la creazione del prodotto Pro (vedi Full Freezer). -->
    <uses-permission android:name="com.android.vending.BILLING"/>
    <!-- La fotocamera per leggere i QR (flutter_zxing -> plugin camera, CameraX): si chiede alla
         prima apertura di /scan (F17.1.10). ⚑ Dichiarata qui anche se camera_android_camerax la
         dichiara gia': il permesso e' del prodotto, non deve dipendere da cosa porta un plugin.
         ☠ Niente ML Kit da quando lo scanner e' ZXing (2026-10-09, «niente dati a Google»): nel
         manifest fuso non devono comparire servizi com.google.mlkit, datatransport o firebase.
         ☠ NIENTE READ_EXTERNAL_STORAGE, anche se il README di receive_sharing_intent lo elenca:
         le immagini condivise arrivano come content:// con un permesso temporaneo concesso dal
         mittente, e il permesso di storage su Play chiede una giustificazione che non abbiamo
         (F17.1.8). Da verificare in F17.2b con una condivisione vera da Galleria e da Chrome. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- ☠ camera_android_camerax dichiara anche microfono e scrittura su storage (servono a chi
         registra video). Noi apriamo la fotocamera con enableAudio: false e non salviamo nulla:
         tolti dal manifest fuso, cosi' Play e l'utente non vedono permessi che non usiamo. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
    <!-- ☠ E il fusore la "deduce" da WRITE_EXTERNAL_STORAGE del plugin (IMPLIED nel report di
         fusione, build/app/outputs/logs/manifest-merger-*-report.txt) anche dopo averla tolta:
         va rimossa esplicitamente, o ricompare nell'APK (visto il 2026-10-09). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <!-- ⚑ La fotocamera non e' obbligatoria: senza, l'app crea QR e li legge da un'immagine. Il
         plugin la dichiara richiesta (default di uses-feature), e Play nasconderebbe l'app ai
         dispositivi senza fotocamera. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false"
        tools:replace="android:required"/>

    <!-- ⚑ allowBackup="false": nel database ci sono password del Wi-Fi e testi privati (F17.1.4).
         Il backup automatico di Android li porterebbe sul Drive dell'utente senza che l'abbia
         scelto; il backup lo fa solo l'utente, col Pro, in un file che vede. -->
    <application
        android:label="QR Me"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <!-- ⚑ singleTask e non singleTop: una condivisione con l'app gia' aperta deve arrivare
             alla stessa attivita' (onNewIntent), non aprirne una seconda sopra l'app del
             mittente. Lo chiede receive_sharing_intent (F17.1.8). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- ☠ Deep link di Flutter spento (pagato con Full Freezer, 2026-10-07; F17.1.11 punto 6):
                 acceso, Flutter passerebbe a go_router anche gli intent in arrivo e go_router
                 cercherebbe una rotta, mostrando "Non trovato". Le condivisioni le riceve il
                 plugin di micro_share. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Condividi -> QR Me (F17.1.8): un testo o un link (un URL arriva come testo)... -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- ...oppure un'immagine, da cui leggere un QR (es. uno screenshot). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- ☠ Da Android 11 un'app non "vede" le altre se non le dichiara: senza queste righe
             canLaunchUrl risponde false e "Apri link", "Chiama", "Scrivi email" e "Manda SMS"
             del QR letto (F17.1.6) sembrerebbero non avere nessuna app (F17.1.10). -->
        <!-- ⚑ Tutte con ACTION_VIEW: e' l'azione con cui url_launcher su Android apre ogni URL,
             e canLaunchUrl interroga proprio quella. `sms` accanto a `smsto`: il QR usa SMSTO:
             (F17.1.3), ma per aprire l'app dei messaggi si puo' passare da sms:. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="smsto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="sms"/>
        </intent>
    </queries>
</manifest>
