<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Notifiche pianificate. Vedi develop_microapps.md F3.8.

         RECEIVE_BOOT_COMPLETED: gli allarmi di Android non sopravvivono al riavvio del
         telefono. Senza questo permesso e senza ScheduledNotificationBootReceiver, dopo
         un riavvio l'utente semplicemente smette di ricevere i promemoria, e non c'e'
         niente che glielo dica.

         SCHEDULE_EXACT_ALARM e non USE_EXACT_ALARM: il secondo non chiede niente
         all'utente ma richiede giustificazione e revisione da parte di Google Play, e
         non regge un'app di promemoria domestici. Col primo si chiede il permesso, e se
         l'utente rifiuta si pianifica in modo inesatto: il promemoria arriva lo stesso,
         eventualmente in ritardo. L'app funziona comunque. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <!-- Gli acquisti in-app. La libreria di fatturazione di Google la dichiara gia' per
         conto suo, e il manifest fuso la conterrebbe comunque: e' scritta qui lo stesso
         perche' e' il manifest dell'app a dire cosa l'app fa, e perche' basta che un giorno
         qualcuno tolga o sostituisca la dipendenza degli acquisti perche' il permesso
         sparisca in silenzio. Senza, Play Console rifiuta di creare prodotti in-app: si
         guarda il bundle caricato, non il codice. -->
    <uses-permission android:name="com.android.vending.BILLING"/>
    <application
        android:label="TrashCan"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Il widget della schermata iniziale. Vedi TrashcanWidgetProvider.kt.
             exported="true" e' obbligatorio: chi manda APPWIDGET_UPDATE e' il sistema,
             che e' un'altra applicazione. Con false il widget si puo' aggiungere ma non
             si aggiorna mai, e non compare nessun errore.

             ☠ Le tre azioni dopo APPWIDGET_UPDATE vengono dalla correzione del 2026-10-10
             («alle 00:00 deve cambiare da solo»): TIME_SET e TIMEZONE_CHANGED spostano
             "oggi" e rendono sbagliati gli istanti assoluti degli allarmi, MY_PACKAGE_REPLACED
             li riallinea dopo un aggiornamento. Il provider ridisegna e li ricalcola.

             ☠ NON aggiungere DATE_CHANGED: provato, il sistema non la consegna ai receiver del
             manifest ("Background execution not allowed"). Vedi TrashcanWidgetProvider.onReceive.
             Un'azione tolta da qui non arriva piu', anche se il codice Kotlin la aspetta. -->
        <receiver
            android:name=".TrashcanWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/trashcan_widget_info" />
        </receiver>

        <!-- ☠ Senza questo receiver l'allarme di mezzanotte del widget non arriva a nessuno.
             `HomeWidget.scheduleWidgetUpdates` arma l'allarme e non da' errore, il sistema
             lo fa scattare, e la trasmissione cade nel vuoto: il plugin **non dichiara**
             questo receiver nel proprio manifest, lo lascia fare all'app, cosi' chi non
             pianifica niente non si ritrova il permesso di avvio ereditato.

             Il sintomo era un widget fermo a "stasera: organico" riferito alla sera passata
             finche' qualcuno non apriva l'app. Niente nei log, niente nell'interfaccia.

             I filtri sull'avvio e sulla sostituzione del pacchetto servono perche' gli
             allarmi di Android non sopravvivono ne' a un riavvio ne' a un aggiornamento
             dell'app: senza, il widget smette di aggiornarsi al primo dei due eventi. -->
        <receiver
            android:name="es.antonborri.home_widget.HomeWidgetScheduledUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.SCHEDULED_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Senza questi due receiver il plugin non ha nessuno a cui consegnare la
             notifica quando l'allarme scatta: l'app si costruisce, si installa, pianifica
             senza errori, e poi la notifica non arriva mai. Nessun messaggio, nessun log:
             il modo peggiore possibile di rompersi. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
