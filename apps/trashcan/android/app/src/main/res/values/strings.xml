<?xml version="1.0" encoding="utf-8"?>
<!--
  Le stringhe visibili nel selettore di widget di Android.

  Stanno qui e non nei file ARB perche' le legge il sistema, non Flutter: il selettore di
  widget viene disegnato prima che l'app parta. La traduzione italiana sta in
  values-it/strings.xml.
-->
