<?xml version="1.0" encoding="utf-8"?>
<!--
  Lo sfondo dell'intestazione: angoli arrotondati solo in alto.

  Il colore di riempimento NON si mette qui: lo imposta il provider, perche' e' il colore
  del tipo di rifiuto della sera. Qui resta solo la forma.

  ☠ RemoteViews non permette di comporre drawable a runtime: setBackgroundColor sostituisce
  l'intero background, angoli compresi. Per tenere gli angoli e cambiare il colore si usa
  setColorFilter su un ImageView di sfondo, oppure - come qui - si tinge il drawable con
  setInt("setBackgroundResource") + setColorFilter. La via piu' semplice che regge su tutte
  le versioni e' un ImageView dietro al testo, tinto con setColorFilter.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="18dp"
        android:topRightRadius="18dp" />
    <solid android:color="#FFFFFFFF" />
</shape>
