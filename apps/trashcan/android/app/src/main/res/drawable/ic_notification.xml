<?xml version="1.0" encoding="utf-8"?>
<!--
  L'icona della barra di stato: cestino su calendario, in silhouette.

  ☠ Android ignora i colori di questa icona: usa solo il canale alfa e la ridisegna in
  bianco. Quindi qui NON si puo' usare l'alone colorato dell'icona del launcher, che
  diventerebbe opaco come il resto: lo stacco fra cestino e calendario si ottiene
  lasciando trasparente la fessura attorno al cestino, cioe' disegnando il calendario con
  un'apertura.

  A 24dp nella barra di stato i dettagli fini spariscono: la figura e' volutamente grossa
  e con pochi tratti.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Calendario con una finestra vuota al centro, dove entra il cestino. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,6 h16 a1,1 0 0 1 1,1 v13 a1,1 0 0 1 -1,1 h-16 a1,1 0 0 1 -1,-1 v-13 a1,1 0 0 1 1,-1 z M5,10 v9 h3.2 v-8 h7.6 v8 h3.2 v-9 z" />

    <!-- Anelli. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7,3 h2 v4 h-2 z M15,3 h2 v4 h-2 z" />

    <!-- Il cestino. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10,13 h4 v7 h-4 z M9,11.4 h6 v1.2 h-6 z M11,10 h2 v1.2 h-2 z" />
</vector>
