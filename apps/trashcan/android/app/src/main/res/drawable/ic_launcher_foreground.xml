<?xml version="1.0" encoding="utf-8"?>
<!--
  Il primo piano dell'icona adattiva.

  Il viewport e' 108x108 e non 24x24: Android ritaglia le icone adattive in forme diverse
  (cerchio, quadrato con angoli, goccia) e i 18dp esterni per lato possono sparire. La
  figura sta dentro il riquadro centrale di 72x72, cioe' fra 18 e 90, altrimenti su un
  launcher che ritaglia a cerchio il bidone viene tagliato.

  Il bidone e' disegnato in una griglia 24x24 e riportato al centro con un group che
  trasla di 30 e scala di 2: 24 * 2 = 48, centrato in 108 significa partire da 30.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="30"
        android:translateY="30"
        android:scaleX="2"
        android:scaleY="2">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M6,19c0,1.1 0.9,2 2,2h8c1.1,0 2,-0.9 2,-2V7H6v12zM19,4h-3.5l-1,-1h-5l-1,1H5v2h14V4z" />
    </group>
</vector>
