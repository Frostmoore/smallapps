<?xml version="1.0" encoding="utf-8"?>
<!--
  Il widget: stretto e verticale, due fasce.

  Sopra, su fondo colorato del tipo di rifiuto, cosa si butta stasera, in grande.
  Sotto, su fondo bianco, i prossimi giorni in piccolo.

  ⚑ La proporzione non e' estetica: il widget viene guardato di sera, di sfuggita, spesso
  da un metro. La domanda "cosa butto stasera" deve avere una risposta leggibile senza
  mettere a fuoco; tutto il resto e' contorno e sta in corpo piccolo.

  ☠ Solo LinearLayout, TextView e ImageView: RemoteViews accetta un sottoinsieme ristretto
  di view, e un ConstraintLayout qui produce un widget che non si disegna, senza errori in
  logcat.

  ☠ L'intestazione ha un ImageView di sfondo invece di un colore sulla view: setBackgroundColor
  sostituisce il drawable e con lui gli angoli arrotondati. Tingendo un ImageView con
  setColorFilter il colore cambia e la forma resta.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Intestazione: stasera. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/widget_header_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_header_background"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/widget_calendar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:maxLines="1" />

            <!--
              Icona e nome affiancati, come nella card "Stasera" della home.

              L'icona e' un bitmap disegnato dal lato Dart a partire dal glifo Material
              (vedi TrashcanWidget._writeIcon): RemoteViews non sa disegnare glifi, e
              ricopiare le ventidue icone in altrettanti vector drawable darebbe due
              cataloghi da tenere allineati a mano. Resta nascosta finche' non c'e' niente
              da buttare.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="-2dp"
                    android:maxLines="3"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Corpo: i prossimi giorni. -->
    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_body_background"
        android:padding="12dp">

        <TextView
            android:id="@+id/widget_upcoming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp"
            android:textColor="#FF1B1F1A"
            android:maxLines="4"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FF6B7268"
            android:maxLines="2"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
